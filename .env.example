# Local-only adapter for development. In-memory data is not durable.
MCQFORGE_STORAGE_DRIVER=memory

# Production storage: set MCQFORGE_STORAGE_DRIVER=redis and provide server-only credentials.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Required in production for CSRF origin validation, e.g. https://mcqforge.example
# APP_ORIGIN=

# Anonymous session policy (seconds): two-hour inactivity, 24-hour hard lifetime.
SESSION_IDLE_TTL_SECONDS=7200
SESSION_MAX_LIFETIME_SECONDS=86400

# Stored JSON size cap (bytes) and per-minute limits.
MAX_TEMPORARY_RECORD_BYTES=2097152
UPLOAD_RATE_LIMIT_PER_MINUTE=5
TEST_CREATION_RATE_LIMIT_PER_MINUTE=10

# Existing upload limit (bytes).
MAX_DOCUMENT_UPLOAD_BYTES=4194304
